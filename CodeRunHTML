<style>
body{
  margin:0;
  font-family:Arial, sans-serif;
  background:#f2f2f2;
}
header{
  background:#222;
  color:#fff;
  padding:15px;
  text-align:center;
}
textarea{
  width:100%;
  height:160px;
  padding:10px;
  box-sizing:border-box;
}
.tabs{
  display:flex;
}
.tabs button{
  flex:1;
  padding:10px;
  border:none;
  background:#ddd;
}
.editor{display:none;}
.editor.active{display:block;}
.controls{
  display:flex;
  gap:5px;
  padding:10px;
}
.controls button{
  flex:1;
  padding:10px;
  border:none;
  background:#4CAF50;
  color:white;
}
iframe{
  width:100%;
  height:260px;
  border:none;
  background:white;
}
footer{
  text-align:center;
  font-size:13px;
  padding:10px;
}
</style>
</head>

<body>

<header>
<h1>Run HTML Online</h1>
<p>Free HTML, CSS & JavaScript Runner</p>
</header>

<div class="tabs">
<button onclick="openTab('html')">HTML</button>
<button onclick="openTab('css')">CSS</button>
<button onclick="openTab('js')">JS</button>
</div>

<div id="html" class="editor active">
<textarea id="htmlCode">
<h2>Hello World</h2>
<button onclick="alert('HTML Runner Working')">Click Me</button>
</textarea>
</div>

<div id="css" class="editor">
<textarea id="cssCode">
body{background:lightyellow;text-align:center;}
button{font-size:18px;}
</textarea>
</div>

<div id="js" class="editor">
<textarea id="jsCode">
console.log("Runner Ready");
</textarea>
</div>

<div class="controls">
<button onclick="runCode()">▶ Run</button>
<button onclick="saveCode()">💾 Save</button>
</div>

<iframe id="output"></iframe>

<footer>
© 2026 Run HTML Online | Free Tool
</footer>

<script>
function openTab(tab){
 document.querySelectorAll('.editor').forEach(e=>e.classList.remove('active'));
 document.getElementById(tab).classList.add('active');
}

function runCode(){
 let html=document.getElementById("htmlCode").value;
 let css="<style>"+cssCode.value+"</style>";
 let js="<script>"+jsCode.value+"<\/script>";
 output.srcdoc=html+css+js;
}

function saveCode(){
 localStorage.setItem("html",htmlCode.value);
 localStorage.setItem("css",cssCode.value);
 localStorage.setItem("js",jsCode.value);
 alert("Code Saved");
}

htmlCode.value=localStorage.getItem("html")||htmlCode.value;
cssCode.value=localStorage.getItem("css")||cssCode.value;
jsCode.value=localStorage.getItem("js")||jsCode.value;
</script>

</body>
</html>
